# Backend Stripe Keys
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (create these in your Stripe Dashboard → Product Catalog)
STRIPE_PRICE_DISTRO_ONLY=price_xxx
STRIPE_PRICE_ARTIST_PRO=price_xxx
STRIPE_PRICE_LABEL_LAUNCHPAD=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx
STRIPE_PRICE_AI_REVIEW=price_xxx
STRIPE_PRICE_SYNC_PACK=price_xxx
STRIPE_PRICE_RADIO_BOOST=price_xxx
STRIPE_PRICE_STREAMING_BLITZ=price_xxx
STRIPE_PRICE_TOUR_PLAN=price_xxx

# Database (Neon/Postgres). Leave unset to use local SQLite.
DATABASE_URL=postgresql://user:pass@host/db

# JWT Auth — REQUIRED. The server refuses to boot until these are set.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-64-char-random-string
JWT_EXPIRE_HOURS=24
# Comma-separated list of YOUR owner login emails (replaces the seller's).
OWNER_EMAILS=you@example.com
# Master password for owner logins. Store it in a password manager.
OWNER_MASTER_PASSWORD=change-this-in-production

# SMTP
SMTP_HOST=mail.redemptionroadmg.com
SMTP_PORT=587
SMTP_USER=mail@redemptionroadmg.com
SMTP_PASSWORD=xxx

# Frontend URL (for CORS / checkout redirects)
FRONTEND_URL=https://redemptionroadmg.com

# Server
PORT=8765